# Postgres connection string. Use Vercel Postgres, Neon, Supabase, or local.
# Example: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# 32+ byte secret for signing JWT session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Public URL of the deployed app (used for absolute redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Which physical deployment this is — DEV, TEST, or PROD. Shown as a colored badge
# in the header/sidebar/login page so no one mistakes one environment for another.
# Set per-deployment (not editable in the app UI on purpose — see
# components/layout/EnvironmentBadge.tsx). Leave unset to hide the badge.
NEXT_PUBLIC_APP_ENVIRONMENT=DEV
