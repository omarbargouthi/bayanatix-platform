# Copy to /opt/bayanis/.env on the server and fill in. Never commit the real file.
# Generate each secret with:  openssl rand -hex 32

# The address the demo is served on (DNS must point at this server before first start).
APP_DOMAIN=demo.example.com

# Set by the release workflow; "latest" when starting by hand.
APP_VERSION=latest

POSTGRES_PASSWORD=
KPI_SANDBOX_ROLE_PASSWORD=

AUTH_SECRET=
CRON_SECRET=
# 32 bytes hex (openssl rand -hex 32). Stored data-source passwords, AI provider keys and
# sign-in secrets are encrypted with it: a database restored from another machine can only
# read them back with THAT machine's key.
LLM_SECRETS_MASTER_KEY=
# Old keys during a rotation, comma-separated: values they encrypted stay readable until
# Configuration > Encryption Keys re-encrypts them. Empty otherwise.
LLM_SECRETS_PREVIOUS_KEYS=

LICENSE_KEY=
ANTHROPIC_API_KEY=
