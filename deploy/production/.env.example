# Copy to /opt/bayanis/.env on the server and fill in. Never commit the real file.
# Generate each secret with:  openssl rand -hex 32

# The address the demo is served on (DNS must point at this server before first start).
APP_DOMAIN=demo.example.com

# Set by the release workflow; "latest" when starting by hand.
APP_VERSION=latest

POSTGRES_PASSWORD=
KPI_SANDBOX_ROLE_PASSWORD=

AUTH_SECRET=
CRON_SECRET=
# 32 bytes hex (openssl rand -hex 32). Stored data-source passwords, AI provider keys and
# sign-in secrets are encrypted with it: a database restored from another machine can only
# read them back with THAT machine's key.
LLM_SECRETS_MASTER_KEY=
# Old keys during a rotation, comma-separated: values they encrypted stay readable until
# Configuration > Encryption Keys re-encrypts them. Empty otherwise.
LLM_SECRETS_PREVIOUS_KEYS=

# Secrets backend for new values: local (the key above) or vault-transit (HashiCorp Vault
# holds the key). See README "Keeping the key in HashiCorp Vault".
SECRETS_PROVIDER=local
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_NAMESPACE=                 # Vault Enterprise only
# VAULT_TRANSIT_MOUNT=transit
# VAULT_TRANSIT_KEY=bayanis
# VAULT_AUTH_METHOD=approle        # token | approle | kubernetes
# VAULT_ROLE_ID=
# VAULT_SECRET_ID_FILE=/run/secrets/vault_secret_id   # or VAULT_SECRET_ID=
# VAULT_TOKEN_FILE=                # token auth (e.g. a Vault Agent sink), or VAULT_TOKEN=
# VAULT_K8S_ROLE=                  # kubernetes auth (service account token is read automatically)
# NODE_EXTRA_CA_CERTS=/certs/vault-ca.pem   # when Vault uses a private CA
# Password fields may hold a Vault KV reference (path#field) when VAULT_ADDR is set, with
# either SECRETS_PROVIDER. Limit them to these path prefixes (comma-separated):
# VAULT_KV_ALLOWED_PATHS=secret/bayanis/

LICENSE_KEY=
ANTHROPIC_API_KEY=
